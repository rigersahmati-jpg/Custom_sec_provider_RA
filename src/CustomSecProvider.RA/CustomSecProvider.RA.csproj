      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.SecurityProvider.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GrapeCity.Enterprise.Identity.ExternalIdentityProvider">
      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.ExternalIdentityProvider.dll</HintPath>
      <Private>false</Private>
