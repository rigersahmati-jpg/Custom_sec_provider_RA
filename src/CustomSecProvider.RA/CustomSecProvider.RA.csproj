<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Windows local (Wyn installed) references only -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.SecurityProvider.dll')">
    <Reference Include="GrapeCity.Enterprise.Identity.SecurityProvider">
      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.SecurityProvider.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GrapeCity.Enterprise.Identity.ExternalIdentityProvider">
      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.ExternalIdentityProvider.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GrapeCity.Enterprise.Identity.ExternalIdentityProvider.Configuration">
      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.ExternalIdentityProvider.Configuration.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- CI/Linux: exclude Wyn-specific adapter -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Wyn\CustomSecProviderSecurityProvider.cs" />
  </ItemGroup>

</Project>
