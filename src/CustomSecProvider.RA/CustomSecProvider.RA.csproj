<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CustomSecProvider.RA</AssemblyName>
    <RootNamespace>CustomSecProvider.RA</RootNamespace>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Minimal required NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <!-- Wyn Enterprise SDK References (Version 9.1.00172.0) -->
  <!-- Copy to SecurityProviders folder: HintPath + Private=false = reference only, don't copy -->
  <ItemGroup>
    <Reference Include="GrapeCity.Enterprise.Identity.SecurityProvider">
      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.SecurityProvider.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GrapeCity.Enterprise.Identity.ExternalIdentityProvider">
      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.ExternalIdentityProvider.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
