      <HintPath>C:\Program Files\Wyn Enterprise\Server\GrapeCity.Enterprise.Identity.ExternalIdentityProvider.Configuration.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
